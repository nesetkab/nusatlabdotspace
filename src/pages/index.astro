---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import hero from '../assets/photos/hero.jpg';
---

<BaseLayout>
  <section class="relative isolate overflow-hidden">
    <Image
      src={hero}
      alt="The atrium of Northeastern's ISEC building, with its helix staircase"
      widths={[640, 1024, 1600]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 -z-10 size-full object-cover"
    />
    <div class="absolute inset-0 -z-10 bg-linear-to-t from-ink via-ink/80 to-ink/40"></div>

    <div class="mx-auto max-w-6xl px-5 py-28 sm:py-40">
      <p class="font-mono text-xs uppercase tracking-widest font-medium text-slate">Northeastern Satellite Lab · Est. 2020</p>
      <h1 class="mt-4 max-w-3xl font-display text-4xl font-medium sm:text-6xl">
        <span class="block text-white">Welcome to</span>
        <span class="block font-features-['smcp'] text-slate">Northeastern <span class="text-clay">Satellite</span> Lab</span>
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-alice">
        We're a student-run club designing, building, and launching CubeSats and more — real spacecraft,
        built by undergrads across hardware, software, and simulations.
      </p>
      <div class="mt-10 flex flex-wrap gap-4">
        <a href="/projects" class="rounded-md bg-clay px-5 py-3 font-semibold text-ink no-underline hover:bg-alice hover:no-underline">
          Explore our work →
        </a>
        <a href="/contact#mailing" class="rounded-md border border-alice/40 px-5 py-3 font-semibold text-alice no-underline hover:border-clay hover:text-clay hover:no-underline">
          Join the mailing list
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
