---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import hero from '../assets/photos/hero.jpg';
import { Section, SectionHeading, OrgList, Org, Grid, Card, MailingListForm } from '../components';
import WhatIsNsl from '../partials/what-is-nsl.mdx';
import WhatIsACubeSat from '../partials/what-is-a-cubesat.mdx';
import AlumniEmployers from '../partials/alumni-employers.mdx';

const facts = [
  { label: 'Founded', value: '2020', note: 'as Project Horizon' },
  { label: 'First launch', value: 'Apr 2026', note: 'PROVES Atlas, from the ISS' },
  { label: 'Next up', value: 'TeraLink-1', note: '6U · 225 GHz · in CDR' },
  // Keep in sync with projects.mdx. Counts everything under way; skips GTOC-14 (forming interest) and ChipSats (up next).
  { label: 'Active projects', value: '10', note: 'missions, competitions & R&D' },
];

const basics = [
  { q: 'What is NSL?', Answer: WhatIsNsl },
  { q: 'What is a CubeSat?', Answer: WhatIsACubeSat },
];

// Full team descriptions live on the About page.
const teams = [
  { title: 'Hardware', body: 'Mechanical, electrical, and embedded work on spacecraft and ground hardware.' },
  { title: 'Software', body: 'Flight and ground-station software, from control algorithms to comms.' },
  { title: 'Simulations', body: 'Orbit and mission simulation, and models to test control loops.' },
  { title: 'Business', body: 'Competitions, proposals, funding, outreach, and recruiting.' },
];
---

<BaseLayout>
  <section>
    <div class="mx-auto max-w-6xl px-5 pt-16 sm:pt-24">
      <h1 class="font-display text-4xl font-medium font-features-['smcp'] text-white sm:text-[length:min(calc((100vw_-_2.5rem)/18),4rem)] sm:whitespace-nowrap">
        Northeastern <span class="text-clay">Satellite</span> Lab
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-alice">
        We're a student club at Northeastern that designs, builds, and launches CubeSats. Our first satellite,
        PROVES Atlas, deployed from the International Space Station in April 2026.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/projects" class="bg-clay px-5 py-3 font-semibold text-ink no-underline hover:bg-alice hover:no-underline">
          See our projects
        </a>
        <a href="/contact#mailing" class="border border-dusk px-5 py-3 font-semibold text-alice no-underline hover:border-clay hover:text-clay hover:no-underline">
          Join the mailing list
        </a>
      </div>

      <dl class="mt-16 grid grid-cols-2 border-t border-dusk md:grid-cols-4">
        {facts.map(({ label, value, note }) => (
          <div class="border-dusk/60 py-5 pr-4 max-md:odd:border-r max-md:[&:nth-child(n+3)]:border-t md:border-r md:px-5 md:first:pl-0 md:last:border-r-0">
            <dt class="font-mono text-xs text-slate">{label}</dt>
            <dd class="mt-2 font-display text-2xl font-medium text-white">{value}</dd>
            <dd class="mt-1 text-sm text-slate">{note}</dd>
          </div>
        ))}
      </dl>
    </div>

    <figure class="mx-auto mt-4 max-w-6xl px-5">
      <Image
        src={hero}
        alt="The atrium of Northeastern's ISEC building, with its helix staircase"
        widths={[640, 1024, 1600]}
        sizes="(min-width: 1152px) 1112px, 100vw"
        loading="eager"
        fetchpriority="high"
        class="aspect-[21/9] w-full border border-dusk/60 object-cover"
      />
      <figcaption class="mt-3 font-mono text-xs text-slate">Fig. 1 · The ISEC atrium, Northeastern University</figcaption>
    </figure>
  </section>

  <Section>
    <SectionHeading title="In the press" />
    <Grid cols={3}>
      <Card eyebrow="The Huntington News" title="Northeastern Satellite Laboratory prepares for interstellar debut with cube satellite" href="https://huntnewsnu.com/92573/primary-homepage/northeastern-satellite-laboratory-prepares-for-interstellar-debut-with-cube-satellite/" />
      <Card eyebrow="Northeastern Global News" title="Students reach for the stars with launch of first satellite" href="https://news.northeastern.edu/2026/03/20/student-club-satellite-launch/" />
      <Card eyebrow="Northeastern College of Engineering" title="New Space Engineering Club Set to Launch Their First Satellite" href="https://coe.northeastern.edu/news/new-space-engineering-club-set-to-launch-their-first-satellite/" />
      <Card eyebrow="Northeastern College of Engineering" title="Student Club Is Innovating To Lower the Cost of Satellites" href="https://coe.northeastern.edu/news/northeastern-undergraduates-innovate-satellite-development-through-project-horizon/" />
      <Card eyebrow="Northeastern Global News" title="Building a space satellite isn't cheap. These Northeastern students are researching ways to bring the cost way down." href="https://news.northeastern.edu/2024/09/16/satellite-development-cost-project-horizon/" />
    </Grid>
  </Section>

  <Section>
    <SectionHeading title="The basics" />
    <div class="mt-8 max-w-3xl divide-y divide-dusk/60 border-b border-dusk/60">
      {basics.map(({ q, Answer }) => (
        <details class="group py-5">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-lg font-semibold text-white [&::-webkit-details-marker]:hidden">
            {q}
            <svg class="size-5 shrink-0 text-clay transition-transform group-open:rotate-45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true">
              <path d="M12 5v14M5 12h14" />
            </svg>
          </summary>
          <div class="mt-4 space-y-4 text-alice"><Answer /></div>
        </details>
      ))}
    </div>
  </Section>

  <Section>
    <SectionHeading
      title="Teams"
      sub="Every member joins a team and works on real flight hardware, software, mission analysis, or the business side that keeps missions funded.
      You don't need to be an engineer to join, and you can join as many teams as you're willing to put in the time for."
    />
    <Grid cols={4}>
      {teams.map(({ title, body }) => (
        <Card title={title} href="/about#teams">{body}</Card>
      ))}
    </Grid>
  </Section>

  <Section>
    <SectionHeading
      title="What we work on"
      sub="CubeSats are the main event. We're also building a sub-THz ground station, entering national competitions like NASA Space to Soil, and writing open-source tools other student teams can use."
    />
    <Grid cols={2}>
      <Card title="Projects" href="/projects">
        The full list: satellite and ground-station programs, competitions, and open-source R&D.
      </Card>
      <Card title="Programs" href="/programs">
        Longer write-ups of our flagship missions: PROVES Atlas, TeraLink-1, and the Sub-THz Ground Station.
      </Card>
    </Grid>
  </Section>

  <Section>
    <SectionHeading
      title="Partners"
      sub="The agencies, labs, and university teams we build with, and the companies our members and alumni go on to work for."
    />
    <div class="mt-8 border-b border-dusk/60">
      <OrgList label="Partners, collaborators & mentors">
        <Org>NASA CSLI</Org>
        <Org>AFRL UNP</Org>
        <Org>INSI</Org>
        <Org>UNLab</Org>
        <Org>NSF CIRC</Org>
        <Org>PROVES</Org>
        <Org>Cal Poly Pomona Bronco Space</Org>
        <Org>MIT Satellite Team</Org>
        <Org>Morehead State University</Org>
      </OrgList>
      <OrgList label="Members & alumni work at"><AlumniEmployers /></OrgList>
    </div>
  </Section>

  <Section id="mailing">
    <SectionHeading
      title="Mailing list"
      sub="Meeting times, launch news, and ways to get involved. For Northeastern students and the NSL community."
    />
    <MailingListForm />
  </Section>
</BaseLayout>
