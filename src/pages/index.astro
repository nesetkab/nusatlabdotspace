---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import hero from '../assets/photos/hero.jpg';
import { Section, SectionHeading, Org, OrgList, Grid, Card, StatusTag, MailingListForm } from '../components';
import WhatIsNsl from '../partials/what-is-nsl.mdx';
import WhatIsACubeSat from '../partials/what-is-a-cubesat.mdx';
import AlumniEmployers from '../partials/alumni-employers.mdx';

const facts = [
  { label: 'In orbit', value: 'PROVES Atlas', note: 'Deployed from the ISS, April 2026' },
  { label: 'Next review', value: 'TeraLink-1 CDR', note: 'AFRL University Nanosatellite Program, November' },
  { label: 'Founded', value: '2020', note: 'As Project Horizon, within AeroNU' },
  { label: 'Meetings', value: 'Mon to Thu', note: 'Evenings in Forsyth Hall', href: '/this-semester' },
];

const missions = [
  { href: '/programs#proves-atlas', name: 'PROVES Atlas', what: 'Camera CubeSat in a five-university constellation', status: 'Launched' },
  { href: '/programs#teralink-1', name: 'TeraLink-1', what: '6U CubeSat for the first terahertz space-to-ground link', status: 'Critical Design Review' },
  { href: '/programs#sub-thz', name: 'Sub-THz Ground Station', what: '2 m reflector dish, 83 µm surface accuracy', status: 'In design' },
  { href: '/projects#dewsat', name: 'DEWSat', what: 'Drought early-warning satellite with onboard AI', status: 'NASA finalist' },
  { href: '/programs#leonird', name: 'LEONIRD CubeSat', what: 'Payload for an open-source bus, with MIT', status: 'Rising project' },
];

const basics = [
  { q: 'What is NSL?', Answer: WhatIsNsl },
  { q: 'What is a CubeSat?', Answer: WhatIsACubeSat },
];

// Full team descriptions live on the About page.
const teams = [
  { icon: 'wrench', title: 'Hardware', body: 'Structures, PCBs, power systems, and firmware. CAD, fabrication, and test.' },
  { icon: 'zap', title: 'Software', body: 'Flight and ground-station software: control, imaging, communications, and scheduling.' },
  { icon: 'globe', title: 'Simulations', body: 'Orbits, dynamics, and mission analysis in FreeFlyer, STK, Python, and MATLAB.' },
  { icon: 'briefcase', title: 'Business', body: 'Proposals, competitions, funding, outreach, and the operations that keep missions going.' },
] as const;

const press = [
  {
    outlet: 'Northeastern Global News',
    year: '2026',
    title: 'Students reach for the stars with launch of first satellite',
    href: 'https://news.northeastern.edu/2026/03/20/student-club-satellite-launch/',
  },
  {
    outlet: 'The Huntington News',
    title: 'Northeastern Satellite Laboratory prepares for interstellar debut with cube satellite',
    href: 'https://huntnewsnu.com/92573/primary-homepage/northeastern-satellite-laboratory-prepares-for-interstellar-debut-with-cube-satellite/',
  },
  {
    outlet: 'College of Engineering',
    title: 'New Space Engineering Club Set to Launch Their First Satellite',
    href: 'https://coe.northeastern.edu/news/new-space-engineering-club-set-to-launch-their-first-satellite/',
  },
  {
    outlet: 'Northeastern Global News',
    year: '2024',
    title: "Building a space satellite isn't cheap. These Northeastern students are researching ways to bring the cost way down.",
    href: 'https://news.northeastern.edu/2024/09/16/satellite-development-cost-project-horizon/',
  },
  {
    outlet: 'College of Engineering',
    title: 'Student Club Is Innovating To Lower the Cost of Satellites',
    href: 'https://coe.northeastern.edu/news/northeastern-undergraduates-innovate-satellite-development-through-project-horizon/',
  },
];
---

<BaseLayout>
  <section>
    <div class="mx-auto grid max-w-6xl items-end gap-12 px-5 pt-14 pb-14 sm:pt-20 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] lg:gap-16 lg:pb-20">
      <div>
        <p class="label">Student-run satellite lab · Boston</p>
        <h1 class="mt-6 font-display text-[clamp(2.125rem,9vw,4.5rem)] leading-[0.95] font-medium tracking-tight text-white font-features-['smcp']">
          Northeastern <span class="text-clay">Satellite</span> Lab
        </h1>
        <p class="mt-8 max-w-xl text-lg text-pretty text-alice/85 sm:text-xl">
          Undergraduates who design, build, and fly real spacecraft. Our first satellite went to orbit in April 2026.
          The next one is on the bench now.
        </p>
        <div class="mt-10 flex flex-wrap gap-3">
          <a href="/programs" class="btn-primary">See our missions</a>
          <a href="/this-semester" class="btn-ghost">Come to a meeting</a>
        </div>
      </div>

      <figure>
        <Image
          src={hero}
          alt="The helix staircase in the atrium of Northeastern's ISEC building"
          widths={[480, 800, 1200]}
          sizes="(min-width: 1024px) 480px, 100vw"
          loading="eager"
          fetchpriority="high"
          class="aspect-[4/3] w-full border border-line object-cover object-[70%_50%] lg:aspect-square"
        />
        <figcaption class="label mt-3">ISEC, Northeastern University</figcaption>
      </figure>
    </div>

    <div class="mx-auto max-w-6xl px-5">
    <dl class="grid grid-cols-2 border-t border-line lg:grid-cols-4">
      {facts.map(({ label, value, note, href }) => (
        <div class="border-b border-line py-6 pr-4 even:border-l even:pl-4 nth-last-[-n+2]:border-b-0 lg:border-b-0 lg:border-l lg:pl-6 lg:first:border-l-0 lg:first:pl-0">
          <dt class="label">{label}</dt>
          <dd class="mt-3 font-display text-xl font-medium text-white">
            {href ? <a href={href} class="text-white">{value}</a> : value}
          </dd>
          <dd class="mt-1 text-sm text-slate">{note}</dd>
        </div>
      ))}
    </dl>
    </div>
  </section>

  <Section>
    <SectionHeading eyebrow="Missions" title="What we're flying and building" />
    <ul class="mt-12 border-b border-line">
      {missions.map(({ href, name, what, status }) => (
        <li class="border-t border-line">
          <a
            href={href}
            class="group grid gap-x-10 gap-y-2 py-5 text-alice no-underline transition-colors hover:bg-prussian/50 hover:no-underline md:grid-cols-[13rem_minmax(0,1fr)_14rem] md:items-baseline md:px-3 md:-mx-3"
          >
            <span class="order-last md:order-none"><StatusTag>{status}</StatusTag></span>
            <span>
              <span class="block font-display text-xl font-medium text-white group-hover:text-clay">{name}</span>
              <span class="mt-1 block text-slate">{what}</span>
            </span>
            <span aria-hidden="true" class="hidden text-right text-sm text-slate group-hover:text-clay md:block">Read the mission &rarr;</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="mt-8 text-slate md:pl-[15.5rem]">
      Competitions and open-source R&amp;D are on the <a href="/projects">Projects page</a>.
    </p>
  </Section>

  <Section>
    <SectionHeading eyebrow="About" title="A student club that builds spacecraft" />
    <div class="mt-12 grid gap-12 md:grid-cols-2 md:gap-14">
      {basics.map(({ q, Answer }) => (
        <div>
          <h3 class="text-lg font-semibold text-white">{q}</h3>
          <div class="prose-nsl mt-4"><Answer /></div>
        </div>
      ))}
    </div>
  </Section>

  <Section>
    <SectionHeading
      eyebrow="Teams"
      title="Four teams, one spacecraft"
      sub="Every member joins a team and works on real flight hardware, software, mission analysis, or the business that funds it. You don't need to be an engineer."
    />
    <Grid cols={4}>
      {teams.map(({ icon, title, body }) => (
        <Card {icon} {title} href="/about#teams" cta="More about the team">{body}</Card>
      ))}
    </Grid>
  </Section>

  <Section>
    <SectionHeading eyebrow="Press" title="In the news" />
    <ul class="mt-12 border-b border-line">
      {press.map(({ outlet, year, title, href }) => (
        <li class="border-t border-line">
          <a
            href={href}
            class="group grid gap-x-10 gap-y-1 py-5 text-alice no-underline hover:no-underline md:grid-cols-[13rem_minmax(0,1fr)_auto] md:items-baseline"
          >
            <span class="label md:pt-1">{outlet}</span>
            <span class="text-lg text-pretty text-white group-hover:text-clay group-hover:underline">
              {title}<span aria-hidden="true" class="ml-1.5 text-slate">&nearr;</span>
            </span>
            <span class="hidden font-mono text-sm text-slate md:block">{year}</span>
          </a>
        </li>
      ))}
    </ul>
  </Section>

  <Section>
    <SectionHeading
      eyebrow="Partners"
      title="We don't do it alone"
      sub="The agencies, labs, and university teams we build with, and where our members and alumni go on to work."
    />
    <div class="mt-12 grid gap-12 md:grid-cols-[13rem_minmax(0,1fr)] md:gap-10">
      <div class="hidden md:block"></div>
      <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] lg:gap-10">
        <OrgList label="Partners and mentors" cols={1}>
          <Org>NASA CubeSat Launch Initiative</Org>
          <Org>AFRL University Nanosatellite Program</Org>
          <Org>Northeastern INSI</Org>
          <Org>UNLab</Org>
          <Org>NSF CIRC</Org>
          <Org>PROVES</Org>
          <Org>Cal Poly Pomona Bronco Space</Org>
          <Org>MIT Satellite Team</Org>
          <Org>Morehead State University</Org>
        </OrgList>
        <OrgList label="Members and alumni work at"><AlumniEmployers /></OrgList>
      </div>
    </div>
  </Section>

  <Section id="mailing">
    <div class="grid gap-10 md:grid-cols-[13rem_minmax(0,1fr)]">
      <p class="label md:pt-3">Mailing list</p>
      <div class="max-w-2xl">
        <h2 class="font-display text-3xl font-medium tracking-tight text-white sm:text-4xl">Stay in the loop</h2>
        <p class="mt-4 text-lg text-alice/80">
          For Northeastern students and the NSL community: meeting times, launch news, and ways to get involved.
        </p>
        <MailingListForm />
      </div>
    </div>
  </Section>
</BaseLayout>
