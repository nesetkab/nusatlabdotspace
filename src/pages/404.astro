---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found">
  <section class="mx-auto max-w-6xl px-5 py-32">
    <p class="label text-clay">404 · Loss of signal</p>
    <h1 class="mt-6 max-w-3xl font-display text-4xl font-medium tracking-tight text-white sm:text-6xl">This page drifted out of orbit.</h1>
    <p class="mt-6 text-lg text-slate">The page you're looking for doesn't exist or has moved.</p>
    <a href="/" class="btn-primary mt-10">Back to home</a>
  </section>
</BaseLayout>
