---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found">
  <section class="mx-auto max-w-3xl px-5 py-32 text-center">
    <p class="font-mono text-sm uppercase tracking-widest text-clay">404 · Lost signal</p>
    <h1 class="mt-4 text-4xl font-extrabold tracking-tight text-white">This page drifted out of orbit.</h1>
    <p class="mt-4 text-slate">The page you're looking for doesn't exist or has moved.</p>
    <a href="/" class="mt-10 inline-block rounded-md bg-clay px-5 py-3 font-semibold text-ink no-underline hover:bg-alice hover:no-underline">
      Back to home
    </a>
  </section>
</BaseLayout>
