---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found">
  <section class="mx-auto w-full max-w-6xl px-5 py-24">
    <h1 class="font-display text-4xl font-medium text-white sm:text-5xl">Page not found</h1>
    <p class="mt-5 text-lg text-alice/85">
      This page doesn’t exist or has moved. Try the <a href="/">home page</a>.
    </p>
  </section>
</BaseLayout>
