---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PageIntro, Section, SectionHeading, Icon, ContactForm, MailingListForm, contactEmail, socialLinks } from '../components';
---

<BaseLayout
  title="Contact"
  description="Get in touch with the Northeastern Satellite Lab, join the mailing list, or find us on social."
>
  <PageIntro eyebrow="Contact" title="Get in touch">
    Questions, collaborations, or want to join? Email us at <a href={`mailto:${contactEmail}`} class="break-all">{contactEmail}</a>
    or use the form below.
  </PageIntro>

  <Section>
    <div class="grid gap-12 md:grid-cols-2">
      <div>
        <SectionHeading
          eyebrow="Reach the lab"
          title="Send us a message"
          sub="Whether you're a prospective member, a collaborator, or press — drop us a line and we'll get back to you."
        />
        <p class="mt-8 flex items-center gap-3">
          <span class="inline-flex size-11 shrink-0 items-center justify-center rounded-lg bg-dusk/40 text-clay">
            <Icon name="mail" />
          </span>
          <a href={`mailto:${contactEmail}`} class="break-all">{contactEmail}</a>
        </p>
      </div>
      <ContactForm />
    </div>
  </Section>

  <Section alt id="mailing">
    <SectionHeading
      eyebrow="Mailing list"
      title="Join our mailing list"
      sub="For NU and NSL community members — meeting times, launch news, and opportunities to get involved."
    />
    <MailingListForm />
    <p class="mt-6 text-sm text-slate">Project-specific mailing lists (TeraLink-1, THz ground station) are coming soon.</p>
  </Section>

  <Section>
    <SectionHeading eyebrow="Follow along" title="Find us on social" />
    <ul class="mt-8 flex flex-wrap gap-3">
      {socialLinks.map(({ href, label }) => (
        <li>
          <a href={href} class="inline-block rounded-full border border-dusk px-5 py-2 font-medium text-alice no-underline hover:border-clay hover:text-clay hover:no-underline">
            {label}
          </a>
        </li>
      ))}
    </ul>
  </Section>
</BaseLayout>
