---
// Layout for MDX pages in src/pages/. Set these in the page's frontmatter:
//   title (tab/SEO title), description, heading (the h1), lead (intro paragraph).
import BaseLayout from './BaseLayout.astro';
import PageIntro from '../components/layout/PageIntro.astro';

interface Props {
  frontmatter: {
    title: string;
    description?: string;
    heading: string;
    lead?: string;
  };
}

const { title, description, heading, lead } = Astro.props.frontmatter;
---

<BaseLayout {title} {description}>
  <PageIntro title={heading}>{lead}</PageIntro>
  <slot />
</BaseLayout>
