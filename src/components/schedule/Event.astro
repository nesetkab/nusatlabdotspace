---
// One entry in the semester's learning/events list; the children are the description.
interface Props {
  when: string;
  title: string;
}

const { when, title } = Astro.props;
---

<li class="grid gap-1 py-5 sm:grid-cols-[11rem_minmax(0,1fr)] sm:gap-8">
  <p class="text-slate">{when}</p>
  <div>
    <h3 class="font-semibold text-white">{title}</h3>
    <div class="mt-1 max-w-[62ch] text-alice/80">
      <slot />
    </div>
  </div>
</li>
