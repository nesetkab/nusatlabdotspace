---
// One entry in the semester's learning/events list; the children are the description.
interface Props {
  when: string;
  title: string;
}

const { when, title } = Astro.props;
---

<li class="grid gap-2 py-6 md:grid-cols-[13rem_minmax(0,1fr)] md:gap-10">
  <p class="font-mono text-sm text-clay md:pt-0.5">{when}</p>
  <div>
    <h3 class="text-lg font-semibold text-white">{title}</h3>
    <div class="mt-2 text-slate">
      <slot />
    </div>
  </div>
</li>
