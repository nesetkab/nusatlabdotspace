---
// One entry in the semester's events list. The children are the description.
interface Props {
  when: string;
  title: string;
}

const { when, title } = Astro.props;
---

<li class="grid gap-2 py-6 sm:grid-cols-[12rem_1fr] sm:gap-8">
  <p class="font-mono text-sm text-clay">{when}</p>
  <div>
    <h3 class="text-lg font-semibold text-white">{title}</h3>
    <div class="mt-2 text-slate">
      <slot />
    </div>
  </div>
</li>
