---
// Weekly meeting table; the children are <Session> rows.
---

<div class="overflow-x-auto">
  <table class="w-full min-w-lg text-left tabular-nums">
    <thead class="border-b border-dusk text-sm text-slate">
      <tr>
        <th scope="col" class="py-2 pr-6 font-normal">Day</th>
        <th scope="col" class="py-2 pr-6 font-normal">Session</th>
        <th scope="col" class="py-2 pr-6 font-normal">Time</th>
        <th scope="col" class="py-2 pr-6 font-normal">Where</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-line">
      <slot />
    </tbody>
  </table>
</div>
