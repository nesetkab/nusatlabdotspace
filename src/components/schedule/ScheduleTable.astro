---
// Weekly meeting table; the children are <Session> rows.
---

<div class="mt-8 overflow-x-auto border-y border-line">
  <table class="w-full min-w-lg text-left">
    <thead class="label border-b border-line-strong">
      <tr>
        <th scope="col" class="py-3 pr-5 font-medium">Day</th>
        <th scope="col" class="py-3 pr-5 font-medium">Session</th>
        <th scope="col" class="py-3 pr-5 font-medium">Time</th>
        <th scope="col" class="py-3 pr-5 font-medium">Where</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-line">
      <slot />
    </tbody>
  </table>
</div>
