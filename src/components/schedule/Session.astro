---
// One row of the weekly schedule table; the children are the session name.
interface Props {
  day: string;
  time: string;
  where: string;
}

const { day, time, where } = Astro.props;
---

<tr>
  <th scope="row" class="py-4 pr-5 font-semibold text-white">{day}</th>
  <td class="py-4 pr-5"><slot /></td>
  <td class="py-4 pr-5 font-mono text-sm whitespace-nowrap text-clay">{time}</td>
  <td class="py-4 pr-5 text-slate">{where}</td>
</tr>
