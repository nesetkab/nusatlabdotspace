---
// One role in an org chart. Leave `name` off (or "TBD") for an open role; pass `deputy` to show the deputy under the lead.
interface Props {
  role: string;
  name?: string;
  deputy?: string;
  /** Held by a member of a partner lab rather than an NSL student. */
  partner?: boolean;
  href?: string;
}

const { role, name = 'TBD', deputy, partner = false, href } = Astro.props;
const open = (value: string) => value === 'TBD';
---

<li class:list={['rounded-sm border px-4 py-3', partner ? 'border-dashed border-slate/50' : 'border-line']}>
  <p class="text-sm text-slate">{role}</p>
  <p class:list={['font-semibold', open(name) ? 'text-slate' : 'text-white']}>
    {href ? <a href={href} class="text-white">{name}</a> : name}
  </p>
  {partner && <p class="text-sm text-slate italic">Partner lab</p>}
  {deputy && (
    <div class="mt-2 border-t border-line pt-2">
      <p class="text-sm text-slate">Deputy</p>
      <p class:list={['text-sm', open(deputy) ? 'text-slate' : 'text-alice']}>{deputy}</p>
    </div>
  )}
</li>
