---
import Wordmark from '../../assets/brand/nsl-wordmark-light.svg';
import { navLinks } from './links';

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => current === href || current.startsWith(`${href}/`);
---

<header class="sticky top-0 z-40 border-b border-line bg-ink/90 backdrop-blur-md">
  <nav aria-label="Main" class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-6 px-5">
    <a href="/" class="shrink-0" aria-label="Northeastern Satellite Lab home">
      <Wordmark aria-hidden="true" class="h-9 w-auto sm:h-10" />
    </a>

    <ul class="hidden h-full items-stretch gap-6 md:flex">
      {navLinks.map(({ href, label }) => (
        <li class="flex">
          <a
            href={href}
            aria-current={isActive(href) ? 'page' : undefined}
            class="relative flex items-center text-sm text-alice/80 no-underline transition-colors hover:text-white hover:no-underline aria-[current=page]:text-white aria-[current=page]:after:absolute aria-[current=page]:after:inset-x-0 aria-[current=page]:after:-bottom-px aria-[current=page]:after:h-0.5 aria-[current=page]:after:bg-clay"
          >
            {label}
          </a>
        </li>
      ))}
    </ul>

    <details class="group relative md:hidden">
      <summary class="flex cursor-pointer list-none items-center gap-2 py-2 text-sm text-alice [&::-webkit-details-marker]:hidden">
        <span class="group-open:hidden">Menu</span>
        <span class="hidden group-open:inline">Close</span>
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
          <path class="group-open:hidden" d="M4 8h16M4 16h16" />
          <path class="hidden group-open:block" d="M6 6l12 12M18 6L6 18" />
        </svg>
      </summary>
      <ul class="absolute right-0 mt-3 w-60 border border-line bg-ink py-2 shadow-2xl shadow-ink">
        {navLinks.map(({ href, label }) => (
          <li>
            <a
              href={href}
              aria-current={isActive(href) ? 'page' : undefined}
              class="block px-4 py-2.5 text-alice no-underline hover:bg-prussian hover:no-underline aria-[current=page]:text-clay"
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </details>
  </nav>
</header>
