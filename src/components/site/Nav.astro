---
import Wordmark from '../../assets/brand/nsl-wordmark-light.svg';
import { navLinks } from './links';

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => current === href || current.startsWith(`${href}/`);
---

<header class="mx-auto w-full max-w-6xl px-5 pt-6">
  <nav aria-label="Main" class="flex flex-wrap items-center gap-x-10 gap-y-4">
    <a href="/" class="shrink-0" aria-label="Northeastern Satellite Lab home">
      <Wordmark aria-hidden="true" class="h-10 w-auto" />
    </a>
    <ul class="flex flex-wrap gap-x-6 gap-y-1 text-[0.9375rem]">
      {navLinks.map(({ href, label }) => (
        <li>
          <a
            href={href}
            aria-current={isActive(href) ? 'page' : undefined}
            class="text-alice no-underline hover:text-clay hover:underline aria-[current=page]:text-clay aria-[current=page]:underline"
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
