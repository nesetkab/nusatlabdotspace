---
import Logo from '../../assets/brand/nsl-logo-light.svg';
import { navLinks, contactEmail, socialLinks } from './links';
---

<footer class="border-t border-line">
  <div class="mx-auto grid max-w-6xl gap-12 px-5 py-16 md:grid-cols-[13rem_minmax(0,1fr)_minmax(0,1fr)_minmax(0,1fr)] md:gap-10">
    <Logo aria-hidden="true" class="h-14 w-auto self-start justify-self-start" />

    <div>
      <p class="font-semibold text-white">Northeastern Satellite Lab</p>
      <p class="mt-2 max-w-xs text-sm text-slate">
        A student-run club at Northeastern University. We design, build, and launch CubeSats.
      </p>
    </div>

    <div>
      <h2 class="label">Pages</h2>
      <ul class="mt-4 space-y-2 text-sm">
        {navLinks.map(({ href, label }) => (
          <li><a href={href} class="text-alice hover:text-clay">{label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <h2 class="label">Contact</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href={`mailto:${contactEmail}`} class="break-all">{contactEmail}</a></li>
        <li><a href="/contact#mailing" class="text-alice hover:text-clay">Mailing list</a></li>
        {socialLinks.map(({ href, label }) => (
          <li><a href={href} class="text-alice hover:text-clay">{label}</a></li>
        ))}
      </ul>
    </div>
  </div>

  <div class="border-t border-line">
    <p class="mx-auto flex max-w-6xl flex-wrap justify-between gap-x-6 gap-y-1 px-5 py-5 font-mono text-xs text-slate">
      <span>&copy; {new Date().getFullYear()} Northeastern Satellite Lab</span>
      <span>Boston, MA · 42.34° N, 71.09° W</span>
    </p>
  </div>
</footer>
