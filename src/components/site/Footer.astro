---
import Logo from '../../assets/brand/nsl-logo-light.svg';
import { contactEmail, socialLinks } from './links';
---

<footer class="mx-auto w-full max-w-6xl px-5 pb-10">
  <div class="flex flex-wrap items-start gap-x-5 gap-y-4 border-t border-line pt-8 text-sm text-slate">
    <Logo aria-hidden="true" class="h-10 w-auto shrink-0" />
    <div class="space-y-1">
      <p>
        <span class="text-alice">Northeastern Satellite Lab</span>, a student club at Northeastern University in Boston.
      </p>
      <p>
        <a href={`mailto:${contactEmail}`} class="[overflow-wrap:anywhere]">{contactEmail}</a>
        {socialLinks.map(({ href, label }) => (
          <>{' · '}<a href={href}>{label}</a></>
        ))}
        {' · '}<a href="/contact#mailing">Mailing list</a>
      </p>
    </div>
  </div>
</footer>
