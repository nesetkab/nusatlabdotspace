---
// One entry in a <Grid> (or any <ul>/<ol>): a title with an optional status line and body text.
//   tag      : status, shown under the title            (R&D projects, program entries)
//   eyebrow  : small line above the title                (press outlet)
//   numbered : numbers the entry inside <Grid ordered>
//   meta     : small line under the body                 (collaborators)
//   href     : links the title
// The children are the body text.
interface Props {
  title: string;
  as?: 'h2' | 'h3';
  tag?: string;
  eyebrow?: string;
  numbered?: boolean;
  meta?: string;
  href?: string;
  Icon?: (props: Record<string, unknown>) => unknown;
}

const { title, as: Heading = 'h3', tag, eyebrow, numbered = false, meta, href, Icon } = Astro.props;
---

<li class:list={[numbered && '[counter-increment:item]']}>
  {eyebrow && <p class="mb-1 text-sm text-slate">{eyebrow}</p>}
  <Heading
    class:list={[
      'font-semibold text-balance text-white',
      Icon && 'flex items-center gap-2',
      numbered && "before:mr-2 before:font-mono before:font-normal before:text-slate before:content-[counter(item)'.']",
    ]}
  >
    {Icon && <Icon class="size-5 shrink-0 text-clay" aria-hidden="true" />}
    {href ? <a href={href} class="text-white decoration-white/30 hover:text-clay hover:decoration-clay">{title}</a> : title}
  </Heading>
  {tag && <p class="text-sm text-clay">{tag}</p>}
  <div class="mt-2 space-y-3 text-pretty text-alice/80">
    <slot />
  </div>
  {meta && <p class="mt-2 text-sm text-slate">{meta}</p>}
</li>
