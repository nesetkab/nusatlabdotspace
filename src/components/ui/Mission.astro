---
import Section from '../layout/Section.astro';

interface Props {
  id: string;
  name: string;
  status: string;
  /** Key figures, shown as a small spec table. */
  scale?: { big: string; label: string }[];
  collaborators?: string;
  /** Body is placeholder copy awaiting the project team. */
  placeholder?: boolean;
}

const { id, name, status, scale, collaborators, placeholder = false } = Astro.props;
const sentenceCase = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
---

<Section {id} title={name} {status}>
  {Astro.slots.has('figure') && (
    <div class="mb-8 max-w-[68ch]">
      <slot name="figure" />
    </div>
  )}
  <div class="prose-nsl text-alice/90">
    <slot />
  </div>

  {(scale || collaborators) && (
    <div class="mt-8 grid max-w-[68ch] gap-x-10 gap-y-4 sm:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]">
      {scale && (
        <dl class="border-t border-line text-sm">
          {scale.map(({ big, label }) => (
            <div class="flex justify-between gap-6 border-b border-line py-2">
              <dt class="text-slate">{sentenceCase(label)}</dt>
              <dd class="text-right font-mono text-white">{big}</dd>
            </div>
          ))}
        </dl>
      )}
      {collaborators && <p class="text-sm text-slate sm:pt-2">{collaborators}</p>}
    </div>
  )}
  {placeholder && <p class="mt-4 text-sm text-clay/80">Placeholder copy. Full details coming from the team.</p>}
</Section>
