---
// One project write-up: name, status, body, and an optional photo and spec table.
// Used from the MDX pages; the body is the component's children.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Detail from './Detail.astro';

interface Props {
  id: string;
  name: string;
  status: string;
  /** A real photo of the hardware or team, imported from src/assets/photos/. */
  photo?: ImageMetadata;
  photoAlt?: string;
  photoCaption?: string;
  /** Key figures, shown as a small spec table. */
  scale?: { big: string; label: string }[];
  collaborators?: string;
  /** Body is placeholder copy awaiting the project team. */
  placeholder?: boolean;
  reverse?: boolean;
}

const { id, name, status, photo, photoAlt = '', photoCaption, scale, collaborators, placeholder = false, reverse } = Astro.props;
const sentenceCase = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
---

<Detail {id} tag={status} title={name} as="h3" {reverse} boxed={!photo} caption={photoCaption}>
  {photo && (
    <Image
      slot="media"
      src={photo}
      alt={photoAlt}
      widths={[480, 800, 1200]}
      sizes="(min-width: 768px) 40vw, 100vw"
      class="block h-auto w-full rounded-sm"
    />
  )}

  <div class="prose-nsl mt-4 text-alice/90">
    <slot />
  </div>

  {scale && (
    <dl class="mt-6 max-w-md border-t border-line text-sm">
      {scale.map(({ big, label }) => (
        <div class="flex justify-between gap-6 border-b border-line py-2">
          <dt class="text-slate">{sentenceCase(label)}</dt>
          <dd class="text-right text-white tabular-nums">{big}</dd>
        </div>
      ))}
    </dl>
  )}
  {collaborators && <p class="mt-4 text-sm text-slate">{collaborators}</p>}
  {placeholder && <p class="mt-4 text-sm text-clay/80">Placeholder copy. Full details coming from the team.</p>}
</Detail>
