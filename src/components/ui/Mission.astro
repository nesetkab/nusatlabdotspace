---
// One project write-up: status/name/body, with optional illustration and headline stats.
// Without `art` it renders text-only (for projects that don't have an illustration yet).
// Used from the MDX pages; the body is the component's children.
import Detail from './Detail.astro';

interface Props {
  id: string;
  name: string;
  status: string;
  /** SVG component imported from src/assets/missions/. */
  art?: (props: Record<string, unknown>) => unknown;
  artAlt?: string;
  scale?: { big: string; label: string }[];
  collaborators?: string;
  /** Body is placeholder copy awaiting the project team. */
  placeholder?: boolean;
  reverse?: boolean;
}

const { id, name, status, art: Art, artAlt, scale, collaborators, placeholder = false, reverse } = Astro.props;
---

<Detail {id} tag={status} title={name} as="h3" {reverse} boxed={!Art}>
  {Art && <Art slot="media" role="img" aria-label={artAlt} class="block h-auto w-full" />}

  <div class="prose-nsl mt-5">
    <slot />
  </div>

  {scale && (
    <dl class="mt-8 grid grid-cols-3 divide-x divide-line border-y border-line">
      {scale.map(({ big, label }) => (
        <div class="flex flex-col-reverse justify-end px-4 py-4 first:pl-0">
          <dt class="mt-1 text-xs text-slate sm:text-sm">{label}</dt>
          <dd class="font-display text-xl font-medium text-white sm:text-2xl">{big}</dd>
        </div>
      ))}
    </dl>
  )}
  {collaborators && <p class="mt-5 text-sm text-slate">{collaborators}</p>}
  {placeholder && <p class="label mt-5 text-clay/80">Placeholder copy. Full details coming from the team.</p>}
</Detail>
