---
// Media + text block. With something in the "media" slot it's a two-column layout;
// without one (or with `boxed`) the title and text sit side by side instead.
import StatusTag from './StatusTag.astro';

interface Props {
  tag?: string;
  title: string;
  as?: 'h2' | 'h3';
  reverse?: boolean;
  /** Force the text-only layout. Needed when the media slot is filled conditionally, since Astro still reports it as present. */
  boxed?: boolean;
  /** Small caption under the media. */
  caption?: string;
  id?: string;
  class?: string;
}

const { tag, title, as: Heading = 'h2', reverse = false, boxed = false, caption, id, class: className } = Astro.props;
const hasMedia = !boxed && Astro.slots.has('media');
---

<article
  id={id}
  class:list={[
    'scroll-mt-24 grid gap-10',
    hasMedia ? 'items-start md:grid-cols-2 md:gap-14' : 'md:grid-cols-[13rem_minmax(0,1fr)]',
    className,
  ]}
>
  {hasMedia && (
    <figure class:list={[reverse && 'md:order-last']}>
      <div class="overflow-hidden border border-line bg-ink">
        <slot name="media" />
      </div>
      {caption && <figcaption class="label mt-3">{caption}</figcaption>}
    </figure>
  )}
  {hasMedia ? (
    <div>
      {tag && <StatusTag>{tag}</StatusTag>}
      <Heading class="mt-4 font-display text-2xl font-medium tracking-tight text-white sm:text-3xl">{title}</Heading>
      <slot />
    </div>
  ) : (
    <>
      <div>{tag && <StatusTag>{tag}</StatusTag>}</div>
      <div class="max-w-3xl">
        <Heading class="font-display text-2xl font-medium tracking-tight text-white sm:text-3xl">{title}</Heading>
        <slot />
      </div>
    </>
  )}
</article>
