---
// Media and text in two columns. With nothing in the "media" slot, or with `boxed`, it's a single ruled block.
import StatusTag from './StatusTag.astro';

interface Props {
  tag?: string;
  title: string;
  as?: 'h2' | 'h3';
  reverse?: boolean;
  /** Force the single-block layout. Needed when the media slot is filled conditionally, because Astro still reports it as present. */
  boxed?: boolean;
  id?: string;
  class?: string;
}

const { tag, title, as: Heading = 'h2', reverse = false, boxed = false, id, class: className } = Astro.props;
const hasMedia = !boxed && Astro.slots.has('media');
---

<article
  id={id}
  class:list={[
    'scroll-mt-24',
    hasMedia
      ? 'grid items-center gap-10 md:grid-cols-2 md:gap-14'
      : 'border-t border-dusk pt-6',
    className,
  ]}
>
  {hasMedia && (
    <div class:list={['overflow-hidden border border-dusk/60', reverse && 'md:order-last']}>
      <slot name="media" />
    </div>
  )}
  <div>
    {tag && <StatusTag>{tag}</StatusTag>}
    <Heading class="mt-3 font-display text-2xl font-medium text-white sm:text-3xl">{title}</Heading>
    <slot />
  </div>
</article>
