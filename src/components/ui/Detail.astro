---
// Text block with an optional picture beside it. With something in the "media" slot it's a two-column layout;
// without one (or with `boxed`) it's a single column.
import StatusTag from './StatusTag.astro';

interface Props {
  tag?: string;
  title: string;
  as?: 'h2' | 'h3';
  reverse?: boolean;
  /** Force the text-only layout. Needed when the media slot is filled conditionally, since Astro still reports it as present. */
  boxed?: boolean;
  /** Caption under the media. */
  caption?: string;
  id?: string;
  class?: string;
}

const { tag, title, as: Heading = 'h2', reverse = false, boxed = false, caption, id, class: className } = Astro.props;
const hasMedia = !boxed && Astro.slots.has('media');
---

<article
  id={id}
  class:list={['scroll-mt-6', hasMedia && 'grid items-start gap-8 md:gap-12',
    hasMedia && (reverse ? 'md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]' : 'md:grid-cols-[minmax(0,7fr)_minmax(0,5fr)]'), className]}
>
  {hasMedia && (
    <figure class:list={['md:mt-2', !reverse && 'md:order-last']}>
      <slot name="media" />
      {caption && <figcaption class="mt-2 text-sm text-slate">{caption}</figcaption>}
    </figure>
  )}
  <div>
    <Heading class="font-display text-2xl font-medium text-white sm:text-3xl">{title}</Heading>
    {tag && <div class="mt-1"><StatusTag>{tag}</StatusTag></div>}
    <slot />
  </div>
</article>
