---
// Media + text block. With something in the "media" slot it's a two-column layout;
// without one (or with `boxed`) it collapses to a single bordered box.
import StatusTag from './StatusTag.astro';

interface Props {
  tag?: string;
  title: string;
  as?: 'h2' | 'h3';
  reverse?: boolean;
  /** Force the single-box layout. Needed when the media slot is filled conditionally, since Astro still reports it as present. */
  boxed?: boolean;
  id?: string;
  class?: string;
}

const { tag, title, as: Heading = 'h2', reverse = false, boxed = false, id, class: className } = Astro.props;
const hasMedia = !boxed && Astro.slots.has('media');
---

<article
  id={id}
  class:list={[
    'scroll-mt-24',
    hasMedia
      ? 'grid items-center gap-10 md:grid-cols-2 md:gap-14'
      : 'rounded-xl border border-dusk/60 bg-prussian p-6 sm:p-8 [[data-alt]_&]:bg-ink',
    className,
  ]}
>
  {hasMedia && (
    <div class:list={['overflow-hidden rounded-xl border border-dusk/60 bg-ink', reverse && 'md:order-last']}>
      <slot name="media" />
    </div>
  )}
  <div>
    {tag && <StatusTag>{tag}</StatusTag>}
    <Heading class="mt-4 font-display text-2xl font-medium text-white sm:text-3xl">{title}</Heading>
    <slot />
  </div>
</article>
