---
interface Props {
  eyebrow: string;
  title: string;
}

const { eyebrow, title } = Astro.props;
---

<header>
  <div class="mx-auto max-w-6xl px-5 pt-20 pb-16 sm:pt-28 sm:pb-20">
    <p class="label">{eyebrow}</p>
    <h1 class="mt-6 max-w-4xl font-display text-4xl font-medium tracking-tight text-balance text-white sm:text-6xl">{title}</h1>
    <p class="mt-8 max-w-2xl text-lg text-pretty text-alice/85">
      <slot />
    </p>
  </div>
</header>
