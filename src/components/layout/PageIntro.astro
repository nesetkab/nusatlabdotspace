---
interface Props {
  eyebrow: string;
  title: string;
}

const { eyebrow, title } = Astro.props;
---

<header class="border-b border-dusk/60 bg-linear-to-b from-prussian to-ink">
  <div class="mx-auto max-w-6xl px-5 py-20 sm:py-28">
    <p class="font-mono text-xs font-medium uppercase tracking-widest text-slate">{eyebrow}</p>
    <h1 class="mt-4 max-w-3xl font-display text-4xl font-medium text-white sm:text-5xl">{title}</h1>
    <p class="mt-6 max-w-2xl text-lg text-alice">
      <slot />
    </p>
  </div>
</header>
