---
interface Props {
  /** Optional qualifier shown above the title, e.g. the term on the semester page. */
  label?: string;
  title: string;
}

const { label, title } = Astro.props;
---

<header class="border-b border-dusk">
  <div class="mx-auto max-w-6xl px-5 pt-16 pb-12 sm:pt-24 sm:pb-16">
    {label && <p class="mb-4 font-mono text-sm text-clay">{label}</p>}
    <h1 class="max-w-3xl font-display text-4xl font-medium text-white sm:text-6xl">{title}</h1>
    <p class="mt-6 max-w-2xl text-lg text-alice">
      <slot />
    </p>
  </div>
</header>
