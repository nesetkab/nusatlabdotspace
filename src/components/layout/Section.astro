---
// A page section. `class` adds to (or overrides) the default spacing.
interface Props {
  id?: string;
  class?: string;
}

const { id, class: className } = Astro.props;
---

<section id={id} class:list={['mx-auto w-full max-w-6xl scroll-mt-6 px-5 py-12 sm:py-16', className]}>
  <slot />
</section>
