---
// A page section. Sections are separated by a hairline rule, not by alternating background colors.
interface Props {
  id?: string;
  class?: string;
}

const { id, class: className } = Astro.props;
---

<section id={id} class:list={['scroll-mt-20 border-t border-line py-16 sm:py-24', className]}>
  <div class="mx-auto max-w-6xl px-5">
    <slot />
  </div>
</section>
