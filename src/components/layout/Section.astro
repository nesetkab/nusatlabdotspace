---
interface Props {
  id?: string;
  title?: string;
  status?: string;
  sub?: string;
  class?: string;
}

const { id, title, status, sub, class: className } = Astro.props;
---

<section id={id} class:list={['mx-auto w-full max-w-6xl scroll-mt-6 px-5', className]}>
  <div class="grid gap-x-12 gap-y-5 border-t border-line pt-6 pb-16 sm:pb-20 lg:grid-cols-[14rem_minmax(0,1fr)]">
    {title ? (
      <div>
        <h2 class="font-display text-2xl leading-tight font-medium text-balance text-white">{title}</h2>
        {status && <p class="mt-2 text-sm text-clay">{status}</p>}
      </div>
    ) : <div class="max-lg:hidden"></div>}
    <div class="min-w-0">
      {sub && <p class="mb-6 max-w-[68ch] text-lg text-pretty text-alice/85">{sub}</p>}
      <slot />
    </div>
  </div>
</section>
