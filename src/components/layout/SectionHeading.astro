---
// Section heading with a rule above it and an automatic number, 01, 02, … down the page.
// The counter resets on <main>, in global.css.
interface Props {
  title: string;
  sub?: string;
}

const { title, sub } = Astro.props;
---

<div class="border-t border-dusk pt-5 [counter-increment:section]">
  <div class="flex items-baseline gap-5">
    <span aria-hidden="true" class="w-8 shrink-0 font-mono text-sm text-clay before:content-[counter(section,decimal-leading-zero)]"></span>
    <h2 class="font-display text-3xl font-medium text-white sm:text-4xl">{title}</h2>
  </div>
  {sub && <p class="mt-4 max-w-2xl text-lg text-alice">{sub}</p>}
</div>
