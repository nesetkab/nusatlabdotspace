---
interface Props {
  eyebrow?: string;
  title: string;
  sub?: string;
}

const { eyebrow, title, sub } = Astro.props;
---

<div class="max-w-3xl">
  {eyebrow && <p class="font-mono text-xs font-medium uppercase tracking-widest text-clay">{eyebrow}</p>}
  <h2 class="mt-3 font-display text-3xl font-medium text-white sm:text-4xl">{title}</h2>
  {sub && <p class="mt-4 text-lg text-alice">{sub}</p>}
</div>
