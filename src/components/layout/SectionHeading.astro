---
// Section header. On wide screens the eyebrow sits in a left margin column, level with the title.
interface Props {
  eyebrow?: string;
  title: string;
  sub?: string;
}

const { eyebrow, title, sub } = Astro.props;
---

<div class="grid gap-3 md:grid-cols-[13rem_minmax(0,1fr)] md:gap-10">
  {eyebrow && <p class="label md:pt-3">{eyebrow}</p>}
  <div class="max-w-3xl md:col-start-2">
    <h2 class="font-display text-3xl font-medium tracking-tight text-balance text-white sm:text-4xl">{title}</h2>
    {sub && <p class="mt-4 text-lg text-pretty text-alice/80">{sub}</p>}
  </div>
</div>
