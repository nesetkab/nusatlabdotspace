---
import { joinLinks } from '../site/links';
---

<ul class="divide-y divide-line border-y border-line">
  {joinLinks.map(({ href, label, note }) => (
    <li class="py-3">
      <a href={href} class="font-semibold">{label}</a>
      <span class="block text-sm text-slate">{note}</span>
    </li>
  ))}
</ul>
